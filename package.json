{
  "name": "iobroker.sax-power",
  "version": "1.2.3",
  "description": "Connects ioBroker to SAX Power battery storage systems using the SAX Power dashboard API.",
  "author": {
    "name": "GodHunter",
    "email": "godhunter@posteo.de"
  },
  "contributors": [],
  "homepage": "https://github.com/GodHunter/ioBroker.sax-power",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "energy",
    "solar",
    "battery",
    "sax"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodHunter/ioBroker.sax-power.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "suncalc": "^2.0.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@eslint/js": "^9.39.5",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/testing": "^5.3.0",
    "@tsconfig/node22": "~22.0.5",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^20.19.43",
    "@types/suncalc": "^1.9.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^9.39.5",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "www/",
    "io-package.json",
    "LICENSE",
    "docs"
  ],
  "scripts": {
    "prebuild": "rimraf build",
    "build": "npm run prepare:admin && npm run build:all",
    "watch": "build-adapter ts --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "npm run prepare:admin && npm run lint:backend && npm run check:admin && npm run build:all",
    "lint": "eslint -c eslint.config.mjs \"src/**/*.ts\" \"test/**/*.{ts,js,mjs,cjs}\" eslint.config.mjs --no-error-on-unmatched-pattern",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server",
    "build:backend": "build-adapter ts",
    "build:admin": "npm --prefix src-admin run build",
    "watch:backend": "build-adapter ts --watch",
    "watch:admin": "npm --prefix src-admin start",
    "test:admin": "npm --prefix src-admin run typecheck",
    "lint:backend": "eslint -c eslint.config.mjs \"src/**/*.ts\" \"test/**/*.{ts,js,mjs,cjs}\" --no-error-on-unmatched-pattern",
    "check:admin": "npm --prefix src-admin run typecheck",
    "test:history": "mocha --require ts-node/register \"test/history/**/*.test.ts\"",
    "prepare:admin": "npm --prefix src-admin ci --no-audit --no-fund",
    "build:all": "npm run build:backend && npm run build:admin"
  },
  "bugs": {
    "url": "https://github.com/GodHunter/ioBroker.sax-power/issues"
  },
  "readmeFilename": "README.md"
}
